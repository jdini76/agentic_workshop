OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Facebook Page auto-publish (see docs/model-adapters.md). Leave AUTO_PUBLISH_ENABLED unset or
# "true" once credentials below are filled in; set it to "false" to disable auto-publish entirely.
AUTO_PUBLISH_ENABLED=true
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v21.0

# Website auto-publish (see docs/model-adapters.md). Reuses AUTO_PUBLISH_ENABLED above as its
# kill switch -- leave these blank to configure Facebook now and the website later.
# GITHUB_TOKEN needs both Contents (read/write) and Actions (read/write) permissions on the
# GITHUB_REPO fine-grained PAT -- Contents for pushing the rendered site, Actions for triggering
# and polling the deploy workflow that actually gets it onto the server.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
WEBSITE_CANONICAL_URL=https://jordanandthefosters.fun
